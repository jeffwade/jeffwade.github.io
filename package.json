{
  "name": "jeffdo-es",
  "type": "module",
  "version": "0.2.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "a11y": "npm run a11y:aa && npm run a11y:aaa",
    "a11y:aa": "pa11y-ci --config .pa11yci-aa.json",
    "a11y:aaa": "pa11y-ci --config .pa11yci-aaa.json",
    "astro": "astro",
    "build": "astro build",
    "dev": "astro dev",
    "lint": "eslint --ext .astro,.ts,.tsx",
    "preview": "astro preview",
    "tokens": "style-dictionary build --config style-dictionary.config.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@astrojs/react": "^4.2.7",
    "astro": "^6.4.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.6",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "eslint": "^10.4.1",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "pa11y-ci": "^4.1.1",
    "style-dictionary": "^5.4.3",
    "typescript": "^6.0.3"
  }
}
